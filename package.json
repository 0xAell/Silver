{
  "name": "silver-fvg-backtest",
  "version": "1.0.0",
  "description": "Historical Hyperliquid SLV/USDC charts and a weekly Dukascopy silver reference",
  "main": "app.js",
  "scripts": {
    "build:terminal": "esbuild src/terminal/main.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=app.js",
    "build:workbench": "esbuild src/workbench/main.ts --bundle --format=esm --platform=browser --target=es2020 --outfile=workbench/assets/workbench.js",
    "build": "npm run build:terminal && npm run build:workbench",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:data": "python -m unittest discover -s tests -p \"test_*.py\" -q",
    "test": "npm run typecheck && npm run test:unit && npm run test:data && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xAell/Silver.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/0xAell/Silver/issues"
  },
  "homepage": "https://0xaell.github.io/Silver-terminal/",
  "dependencies": {
    "lightweight-charts": "^5.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vite": "8.2.6",
    "rolldown": "1.2.19"
  }
}
